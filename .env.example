# Copy this file to .env and replace every change_me value.
COMPOSE_PROJECT_NAME=gordi
TZ=Asia/Seoul

# Infrastructure image tags
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gordi
MYSQL_USER=gordi
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=gordi
RABBITMQ_DEFAULT_PASS=change_me
RABBITMQ_DEFAULT_VHOST=/

# React (Vite assumed)
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_AI_API_BASE_URL=http://localhost:8000

# Spring Boot
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# FastAPI
AI_HOST=0.0.0.0
AI_PORT=8000
AI_RELOAD=true

# Spring -> FastAPI 내부 호출 (INTERNAL_API_KEY 는 비워두면 검증하지 않음)
AI_INTERNAL_BASE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_MS=2000
AI_READ_TIMEOUT_MS=5000
INTERNAL_API_KEY=

# JWT Settings
JWT_SECRET=change_me
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_ROOM_TOKEN_EXPIRATION=3600000
ROOM_EXPIRATION=7200000

# LiveKit
# API secret은 JJWT HMAC 서명을 위해 최소 32바이트 이상이어야 합니다.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_to_a_random_secret_at_least_32_bytes
LIVEKIT_SERVER_URL=ws://localhost/livekit
# 배포시 LIVEKIT_SERVER_URL=wss://서비스도메인/livekit
LIVEKIT_USE_EXTERNAL_IP=false
# 배포시 LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_TOKEN_EXPIRATION=600000
LIVEKIT_ROOM_NAME_PREFIX=gordi-room-

# OAuth
KAKAO_CLIENT_ID=change_me
KAKAO_CLIENT_SECRET=change_me
OAUTH2_REDIRECT_URL=http://localhost
OAUTH2_FAILURE_REDIRECT_URL=https://localhost

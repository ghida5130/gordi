# ============================================================
# Gordi AI 환경변수 (ai/.env 로 복사해서 사용)
#
# 파트별 env 분리 방침에 따라 AI 관련 변수는 이 파일에서 관리한다.
# - FastAPI 런타임: pydantic-settings 가 ai/.env 를 읽는다
#   (루트 .env 는 전환기 fallback, 같은 키는 ai/.env 가 우선)
# - Docker Compose: ai 서비스가 env_file 로 ai/.env 를 읽는다
# - 수집/시드/임베딩 CLI 도구: 셸 export 또는 docker --env-file 로 전달
#
# 예외 — 루트 .env 에서 계속 관리 (백엔드와 공유하는 값):
#   INTERNAL_API_KEY  (Spring <-> FastAPI 내부 호출 공유 키,
#                      추천 호출 + try-on 접수/콜백 공용)
# ============================================================

# ---------- FastAPI 서버 ----------
AI_HOST=0.0.0.0
AI_PORT=8000
AI_RELOAD=true

# ---------- OpenRouter (임베딩) ----------
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2
OPENROUTER_EMBEDDING_DIMENSIONS=768
OPENROUTER_EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
OPENROUTER_PROVIDER_ORDER=google-vertex
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Gordi AI

# ---------- 카탈로그 벡터 인덱스 ----------
# 로컬 직접 실행 시 기본값은 ai/catalog_index/catalog-embeddings.json
# Compose 는 컨테이너 경로(/app/catalog_index/...)를 environment 로 고정한다
CATALOG_EMBEDDING_INDEX_HOST_DIR=./ai/catalog_index

# ---------- 추천 파이프라인 ----------
RECOMMENDATION_IMAGE_ALLOWED_HOSTS=["localhost","gordi-nginx"]
ENABLE_RECOMMENDATION_DEMO=false
# /rank 를 벡터 파이프라인으로 처리 (인덱스/키 불가 시 baseline 자동 fallback)
RECOMMENDATION_RANK_VECTOR_ENABLED=true

# ---------- 추천 VLM (OpenAI 호환 chat completions) ----------
# 로컬 모델은 endpoint 를 http://localhost:11434/v1/chat/completions 등으로 교체
RECOMMENDATION_VLM_MODEL=openai/gpt-5.6-luna
RECOMMENDATION_VLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
RECOMMENDATION_VLM_API_KEY=
RECOMMENDATION_VLM_TIMEOUT_SECONDS=20
RECOMMENDATION_IMAGE_ATTRIBUTES_ENABLED=false
RECOMMENDATION_VLM_RERANK_ENABLED=false
RECOMMENDATION_VLM_RERANK_TOP_K=20
RECOMMENDATION_VLM_RERANK_CONCURRENCY=8
# OpenAI reasoning 계열(luna 등)은 low 필요, Gemma 등 미지원 모델은 빈 값
RECOMMENDATION_VLM_REASONING_EFFORT=low
RECOMMENDATION_LLM_REASONS_ENABLED=false

# ---------- 착장 이미지 생성 (Nano Banana 2) ----------
TRYON_IMAGE_MODEL=google/gemini-3-pro-image
TRYON_GENERATION_TIMEOUT_SECONDS=180
TRYON_RESULT_BASE_URL=http://localhost:8000/try-on-results
SPRING_INTERNAL_BASE_URL=http://localhost:8080

# ============================================================
# 아래는 수집/시드/임베딩 CLI 도구 전용 (FastAPI 런타임은 읽지 않음)
# 셸 export 또는 docker run --env-file 로 전달한다
# ============================================================

# MySQL (embedding_cli, seed-db)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=gordi
MYSQL_USER=gordi
MYSQL_PASSWORD=

# seed-db 이미지 URL prefix (로컬 placeholder / 운영 S3 내부망 URL)
GARMENT_IMAGE_BASE_URL=http://gordi-nginx

# S3 업로드 (upload-s3, 운영 배포 시)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
GARMENT_S3_BUCKET=

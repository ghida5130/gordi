# Local-only server addresses
IMAGE_DEMO_API_HOST=127.0.0.1
IMAGE_DEMO_API_PORT=8100
IMAGE_DEMO_API_RELOAD=false
IMAGE_DEMO_FRONTEND_HOST=127.0.0.1
IMAGE_DEMO_FRONTEND_PORT=5174
VITE_IMAGE_DEMO_API_BASE_URL=http://127.0.0.1:8100

# Upload and provider timeouts
DEMO_MAX_UPLOAD_MB=10
IMAGE_PROVIDER_TIMEOUT_SECONDS=120

# Optional: required only when mock mode is disabled
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Gordi Image Model Evaluation Demo - Local
OPENROUTER_NANO_BANANA_MODEL=google/gemini-3.1-flash-image
OPENROUTER_NANO_BANANA_LITE_MODEL=google/gemini-3.1-flash-lite-image
OPENROUTER_GPT_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_GROK_IMAGINE_QUALITY_MODEL=x-ai/grok-imagine-image-quality
OPENROUTER_KREA_MEDIUM_MODEL=krea/krea-2-medium
OPENROUTER_FLUX_MAX_MODEL=black-forest-labs/flux.2-max
OPENROUTER_MAI_PRO_MODEL=microsoft/mai-image-2.5

# Optional local FLUX sidecar fallback
FLUX_KLEIN_ENDPOINT=
FLUX_KLEIN_API_KEY=
FLUX_KLEIN_MODEL=FLUX.2-klein-9B-Base
FLUX_KLEIN_LORA_PATH=
FLUX_KLEIN_LORA_SCALE=1.0
